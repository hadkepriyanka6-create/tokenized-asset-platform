# ── API ──────────────────────────────────────────────────────────────────────
# 5000 is taken by AirPlay Receiver on macOS — it answers 403 and looks like a
# broken server. 5050 avoids that.
PORT=5050
CORS_ORIGIN=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/tokenizedAsset
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Chain ────────────────────────────────────────────────────────────────────
# Must be a SEPOLIA endpoint. An Alchemy mainnet URL will connect fine and then
# report "no contract deployed", which is confusing — check the host says
# eth-sepolia, not eth-mainnet.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>

# The deployed CommodityToken.
CONTRACT_ADDRESS=0x...

# The operator wallet. Holds DEFAULT_ADMIN / COMPLIANCE / ISSUER / PAUSER
# on-chain and signs every issuer, compliance and admin action. It never signs
# on a holder's behalf — investors sign purchases, sales and transfers in their
# own wallet. Keep this out of version control.
PRIVATE_KEY=<64 hex characters, no 0x prefix>

# Optional — for `hardhat verify` from chain/.
ETHERSCAN_API_KEY=
